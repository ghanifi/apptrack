# AppTrack ortam değişkenleri — kopyala: cp .env.example .env
# Üretimde TÜM secret'ları güçlü rastgele değerlerle değiştirin.

# ─── Zorunlu (üretim) ───────────────────────────────────────────
SECRET_KEY=change-me-strong-random-64-chars
FERNET_SALT=change-me-random-salt
# Eski anahtardan rotasyon için (opsiyonel):
# SECRET_KEY_OLD=

# ─── Veritabanı / altyapı (docker-compose varsayılanları) ──────
POSTGRES_USER=apptrack
POSTGRES_PASSWORD=apptrack
POSTGRES_DB=apptrack
# REDIS_URL boş bırakılırsa bellek-içi rate limit kullanılır
REDIS_URL=redis://redis:6379/0
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ─── GitHub entegrasyonu ────────────────────────────────────────
# OAuth app (Settings > Connect GitHub akışı için):
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Webhook imza doğrulaması:
GITHUB_WEBHOOK_SECRET=
# Sunucu geneli fallback build token'ı (kullanıcı bazlı token tercih edilir):
GITHUB_ACTIONS_TOKEN=

# ─── Build sağlayıcı webhook secret'ları ────────────────────────
EAS_WEBHOOK_SECRET=
CODEMAGIC_WEBHOOK_SECRET=
ASC_WEBHOOK_SECRET=

# ─── Opsiyonel entegrasyonlar ───────────────────────────────────
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
SMTP_HOST=
GATEWAY_URL=http://gateway:8000
