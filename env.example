# ─── Application ──────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-a-long-random-string
# Stable salt for credential encryption KDF. Generate with:
#   python -c "import secrets; print(secrets.token_hex(16))"
FERNET_SALT=apptrack-fernet-salt-change-me
# Key rotation: Comma-separated list of old SECRET_KEY values.
# When rotating, move the current SECRET_KEY here and set a new SECRET_KEY.
# The system can still decrypt with old keys but encrypts only with the new key.
# After running /api/credentials/rotate-keys for all users, clear this field.
SECRET_KEY_OLD=

# ─── Service-to-Service Auth ──────────────────────────────────────────────────
# HMAC secret for internal service-to-service authentication.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SERVICE_TOKEN_SECRET=

# ─── Security ─────────────────────────────────────────────────────────────────
MAX_REQUEST_SIZE_MB=10
DEVICE_FINGERPRINT_ENABLED=true

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=apptrack
POSTGRES_PASSWORD=apptrack
POSTGRES_DB=apptrack
DATABASE_URL=postgresql+asyncpg://apptrack:apptrack@postgres:5432/apptrack

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_USER=apptrack
RABBITMQ_PASS=apptrack_secret

# ─── MinIO (S3-compatible artifact storage) ───────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ─── GitHub OAuth ─────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── GitHub Webhook (auto-sync on push) ───────────────────────────────────────
# Random secret for HMAC signature verification. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=
# Public URL of the gateway (needed for webhook registration)
GATEWAY_URL=http://localhost:8000

# ─── Build Providers ──────────────────────────────────────────────────────────
# NOTE: EAS_TOKEN and CODEMAGIC_TOKEN are per-user and stored in the credential DB.
# The values below are only for local dev override if needed.
EAS_TOKEN=
CODEMAGIC_TOKEN=
# GitHub Actions personal access token for native builds (Swift/Kotlin)
# Requires 'actions:write' and 'contents:read' scopes.
GITHUB_ACTIONS_TOKEN=

# ─── Build Service Webhook Secrets ────────────────────────────────────────────
# HMAC secrets for verifying webhook calls from EAS and Codemagic.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
EAS_WEBHOOK_SECRET=
CODEMAGIC_WEBHOOK_SECRET=

# ─── Store Deployment ─────────────────────────────────────────────────────────
GOOGLE_PLAY_KEY_FILE=
APP_STORE_KEY_ID=
APP_STORE_ISSUER_ID=
APP_STORE_PRIVATE_KEY=

# ─── Native Device Preview ────────────────────────────────────────────────────
APPETIZE_API_TOKEN=
DOCKER_ANDROID_URL=http://localhost:6080
PREVIEW_HOST=localhost
ENABLE_LIVE_PREVIEW=true

# ─── Monitoring (docker compose --profile monitoring up) ──────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
